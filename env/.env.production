# ==============================================================================
# S.U.P.R.E.M. Production Environment Configuration (.env.production)
# ==============================================================================

PORT=8080
NODE_ENV=production

# Local / Dedicated Inference Node
LOCAL_LLM_URL=http://127.0.0.1:9931/v1/chat/completions
LOCAL_LLM_MODEL=claude-3-5-sonnet-20241022
LOCAL_LLM_TYPE=openai

# Ollama Production Node
OLLAMA_URL=http://127.0.0.1:11434

# Anthropic Claude Key (Set on production host)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Cloud API Keys
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Default Provider
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-3-5-sonnet-20241022

# Production Station Coordinates
WEATHER_CITY=Moxx High Command
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
