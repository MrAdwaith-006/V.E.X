# ==============================================================================
# S.U.P.R.E.M. - Environment Configuration Template (.env.example)
# Copy this file to .env and configure your variables:
#   cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Local Anthropic-Compatible LLM Server (Port 8080 / v1/messages)
LOCAL_LLM_URL=http://127.0.0.1:8080/v1/messages
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_TYPE=anthropic

# Ollama Endpoint
OLLAMA_URL=http://localhost:11434

# Anthropic Claude Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Cloud LLM API Keys (Optional - user can also set via HUD UI)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Default AI Cognitive Matrix Settings
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-3-5-sonnet-20241022

# Weather Telemetry Coordinates
WEATHER_CITY=Moxx Citadel
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
